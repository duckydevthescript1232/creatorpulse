+    private void startGoogleLogin() {
+        try {
+            Intent browser = new Intent(Intent.ACTION_VIEW, android.net.Uri.parse(APP_URL + "/api/auth/google/start?app=1"));
+            startActivity(browser);
+        } catch (Exception error) {
+            showLogin("Google sign-in could not be opened on this device.");
+        }
+    }
+
+    private void handleGoogleAuthIntent(Intent intent) {
+        android.net.Uri data = intent == null ? null : intent.getData();
+        if (data == null || !"creatorpulse".equalsIgnoreCase(data.getScheme()) || !"auth".equalsIgnoreCase(data.getHost())) return;
+        String code = data.getQueryParameter("code");
+        String error = data.getQueryParameter("error");
+        if (error != null && !error.isBlank()) {
+            showLogin("Google sign-in was cancelled or could not be completed.");
+            return;
+        }
+        if (code == null || code.isBlank()) {
+            showLogin("Google sign-in did not return a valid login code.");
+            return;
+        }
+        exchangeGoogleCode(code);
+    }
+
+    private void exchangeGoogleCode(String code) {
+        showMessage("Signing in with Google…", "Finishing your secure CreatorPulse session.", null, null);
+        io.execute(() -> {
+            HttpURLConnection c = null;
+            try {
+                c = api("/api/auth/google/exchange");
+                JSONObject body = new JSONObject();
+                body.put("code", code);
+                write(c, body.toString());
+                int status = c.getResponseCode();
+                saveCookies(c);
+                JSONObject json = json(c, status);
+                if (status >= 200 && status < 300 && json.optBoolean("ok", false)) {
+                    String destination = json.optString("destination", "/dashboard");
+                    runOnUiThread(() -> openApp(destination));
+                } else {
+                    String message = json.optString("error", "Google sign-in could not be completed.");
+                    runOnUiThread(() -> showLogin(message));
+                }
+            } catch (Exception error) {
+                runOnUiThread(() -> showLogin(hasNetwork() ? "CreatorPulse could not finish Google sign-in." : "You are offline."));
+            } finally {
+                if (c != null) c.disconnect();
+            }
+        });
+    }
+
     private void openApp() { openApp("/dashboard"); }
 
