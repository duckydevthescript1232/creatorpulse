+    private void updateBottomSelection(String currentPath) {
+        if (bottom == null) return;
+        String normalized = currentPath == null ? "/dashboard" : currentPath;
+        for (int n = 0; n < bottom.getChildCount(); n++) {
+            View child = bottom.getChildAt(n);
+            if (!(child instanceof LinearLayout)) continue;
+            LinearLayout item = (LinearLayout) child;
+            Object tag = item.getTag();
+            if (!(tag instanceof String)) continue;
+            String target = (String) tag;
+            boolean active = normalized.equals(target)
+                    || ("/dashboard".equals(target) && "/".equals(normalized))
+                    || ("/settings".equals(target) && normalized.startsWith("/settings"));
+            item.setBackground(active ? activeNavDrawable() : null);
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) item.setElevation(active ? dp(5) : 0);
